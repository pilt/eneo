# Copy this to .env.local and fill in your values.
#
# VITE_ASSISTANT_ID — UUID of the eneo assistant to chat with (required)
# VITE_API_KEY      — eneo API key for authentication (if your instance requires it)
# VITE_ENEO_URL     — eneo backend base URL (default: http://localhost:8000)

VITE_ASSISTANT_ID=
VITE_API_KEY=
VITE_ENEO_URL=http://localhost:8000
